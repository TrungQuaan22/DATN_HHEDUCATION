# Public domains (hostnames only for Caddy)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_MEDIA_HOSTNAME=media.example.com
CORS_ORIGIN=https://app.example.com
IMAGE_TAG=latest

# PostgreSQL - URL-encode special characters in DATABASE_URL
POSTGRES_USER=hheducation
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hheducation
DATABASE_URL=postgresql://hheducation:replace-with-a-long-random-password@postgres:5432/hheducation

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-another-32-random-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_REFRESH_TOKEN_RETRY_GRACE_SECONDS=10

# Dedicated Cloudflare R2 production bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=hh-education-prod-media
R2_PUBLIC_BASE_URL=https://media.example.com
R2_PRESIGNED_URL_EXPIRES_IN=300

# Backend to AI service authentication
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-token
AI_SERVICE_REQUEST_TIMEOUT_MS=120000

# OpenAI-compatible embedding and chat providers
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_PROVIDER=openai-compatible
CHAT_API_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4.1-mini
CHAT_TEMPERATURE=0.2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_LIMIT=6
RAG_SIMILARITY_THRESHOLD=0.45

# Payment / SePay
PAYMENT_DEFAULT_PROVIDER=sepay
PAYMENT_PENDING_TTL_MINUTES=15
IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_KEY_STALE_MINUTES=5
SEPAY_WEBHOOK_AUTH_MODE=hmac
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_PAYMENT_CODE_PREFIX=HHE
SEPAY_PAYMENT_CODE_SUFFIX_LENGTH=12

# Assessment worker
ASSESSMENT_DEADLINE_SWEEP_INTERVAL_MS=30000
ASSESSMENT_DEADLINE_SWEEP_BATCH_SIZE=100

# One-time production seed. Remove passwords from the VPS env after seeding.
PRODUCTION_ADMIN_EMAIL=admin@example.com
PRODUCTION_ADMIN_PASSWORD=
PRODUCTION_ADMIN_FULL_NAME=System Administrator
PRODUCTION_TEACHER_EMAIL=teacher@example.com
PRODUCTION_TEACHER_PASSWORD=
PRODUCTION_TEACHER_FULL_NAME=Course Teacher
