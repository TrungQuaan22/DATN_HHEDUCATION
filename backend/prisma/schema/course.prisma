enum CourseStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  quiz
  document
}

enum VideoType {
  system
  youtube
}

enum Subject {
  math
  physics
  chemistry
  literature
  english
  biology
  history
  geography
}

enum EnrollmentSource {
  payment
  manual
}

model Course {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String       @db.VarChar(255)
  slug             String       @db.VarChar(255)
  description      String?
  subject          Subject
  grade            Int
  teacherId        String       @map("teacher_id") @db.Uuid
  thumbnailMediaId String?      @map("thumbnail_media_id") @db.Uuid
  price            Int          @default(0)
  salePrice        Int?         @map("sale_price")
  status           CourseStatus @default(draft)
  allowPreview     Boolean      @default(true) @map("allow_preview")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  teacher           User               @relation("CourseTeacher", fields: [teacherId], references: [id])
  thumbnailMedia    Media?             @relation("CourseThumbnailMedia", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  chapters          Chapter[]
  topics            Topic[]
  courseAssessments CourseAssessment[]
  orderItems        OrderItem[]
  enrollments       Enrollment[]
  courseProgress    CourseProgress[]
  practiceSessions  PracticeSession[]

  @@index([teacherId])
  @@map("courses")
}

model Chapter {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title      String   @db.VarChar(255)
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@index([courseId])
  @@map("chapters")
}

model Lesson {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId    String     @map("chapter_id") @db.Uuid
  title        String     @db.VarChar(255)
  type         LessonType
  description  String?
  videoType    VideoType? @map("video_type")
  videoMediaId String?    @map("video_media_id") @db.Uuid
  youtubeUrl   String?    @map("youtube_url")
  durationSec  Int?       @map("duration_sec")
  orderIndex   Int        @map("order_index")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  chapter           Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  videoMedia        Media?             @relation("LessonVideoMedia", fields: [videoMediaId], references: [id], onDelete: SetNull)
  lessonAssessments LessonAssessment[]
  progress          LessonProgress[]

  @@unique([chapterId, orderIndex])
  @@index([chapterId])
  @@map("lessons")
}

model Enrollment {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  orderId    String?          @map("order_id") @db.Uuid
  source     EnrollmentSource @default(payment)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, courseId])
  @@map("enrollments")
}
